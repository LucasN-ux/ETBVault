generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

// Type de produit scellé. ETB = produit historique ; les autres types sont
// ajoutés au catalogue (displays, booster boxes, coffrets, tins, premium, blisters).
enum ProduitType {
  ETB
  DISPLAY   // booster box / display (CM cat 53)
  BOOSTER   // booster à l'unité (CM cat 52)
  COFFRET   // box set non-premium (CM cat 1015)
  PREMIUM   // premium collection (CM cat 1015, nom « Premium Collection »)
  TIN       // CM cat 1014
  BLISTER   // CM cat 1083
  AUTRE
}

// ── Compte utilisateur (auth JWT + bcrypt) ───────────────────────────────────
// Deux rôles : USER (par défaut) et ADMIN (accès au panel admin).
model User {
  id             String       @id @default(cuid())
  email          String       @unique
  motDePasseHash String       @map("mot_de_passe_hash")
  role           Role         @default(USER)
  createdAt      DateTime     @default(now()) @map("created_at")
  vaultEntries   VaultEntry[]

  @@map("users")
}

// Produit scellé Pokémon (ETB, display, booster box, coffret, tin, premium, blister…).
// Table « etbs » conservée (via @@map) pour ne pas migrer les données existantes ;
// le modèle est désormais générique. Les 66 ETB existants ont type = ETB par défaut.
model Produit {
  id             String           @id
  nom            String                                  // nom exact Cardmarket (EN) — lien CM, i18n future
  nomFr          String?          @map("nom_fr")         // nom d'affichage FR (TCGdex)
  type           ProduitType      @default(ETB)
  setId          String?          @map("set_id")          // set d'appartenance (TCGdex), nullable
  era            String?
  imageUrl       String?          @map("image_url")
  boxImageUrl    String?          @map("box_image_url")
  dateSortie     DateTime?        @map("date_sortie") @db.Date
  prixSortie     Decimal?         @map("prix_sortie") @db.Decimal(10, 2)
  contenu        Json?
  cmUrl          String?          @map("cm_url")
  cmIdProducts   Int[]            @default([]) @map("cm_id_products")  // idProduct Cardmarket pour les prix
  cartes         Carte[]
  prixHistorique PrixHistorique[]
  vaultEntries   VaultEntry[]

  @@map("etbs")
}

model Carte {
  id         String   @id
  produitId  String   @map("etb_id")
  nom        String
  numero     String?
  imageUrl   String?  @map("image_url")
  rarete     String?
  prixMarche Decimal? @map("prix_marche") @db.Decimal(10, 2)
  misAJour   DateTime @default(now()) @map("mis_a_jour")
  produit    Produit  @relation(fields: [produitId], references: [id])

  @@map("cartes")
}

// ── Vault utilisateur ─────────────────────────────────────────────────────────
// Coffre persisté en base, rattaché à un compte (userId).
model VaultEntry {
  id         Int      @id @default(autoincrement())
  userId     String   @map("user_id")
  produitId  String   @map("etb_id")
  prixAchat  Decimal  @map("prix_achat") @db.Decimal(10, 2)
  quantite   Int      @default(1)
  dateAchat  DateTime @map("date_achat") @db.Date
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  produit    Produit  @relation(fields: [produitId], references: [id])

  @@index([userId])
  @@map("vault_entries")
}

model PrixHistorique {
  id            Int      @id @default(autoincrement())
  produitId     String   @map("etb_id")
  date          DateTime @db.Date
  cmPrixMoyen   Decimal? @map("cm_prix_moyen") @db.Decimal(10, 2)
  cmPrixBas     Decimal? @map("cm_prix_bas") @db.Decimal(10, 2)
  cmNbAnnonces      Int?     @map("cm_nb_annonces")
  ebayPrixMoyen     Decimal? @map("ebay_prix_moyen") @db.Decimal(10, 2)
  // Provenance du point : 'collecte' (cron quotidien) ou 'import_cm' (amorçage rétroactif). Cf. CLAUDE.md.
  origine           String   @default("collecte")
  produit       Produit  @relation(fields: [produitId], references: [id])

  @@unique([produitId, date])
  @@map("prix_historique")
}
