generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Connexion applicative. En hébergement (Neon), c'est la chaîne « pooled ».
  url      = env("DATABASE_URL")
  // Connexion directe, réservée aux migrations. Le pooler de Neon travaille en
  // mode transaction : les instructions DDL d'une migration n'y passent pas.
  // Prisma exige la variable dès que `directUrl` est déclaré — en local, lui
  // donner la même valeur que DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

// ── Compte utilisateur (auth JWT + bcrypt) ───────────────────────────────────
// Deux rôles : USER (par défaut) et ADMIN (accès au panel admin).
model User {
  id             String       @id @default(cuid())
  email          String       @unique
  motDePasseHash String       @map("mot_de_passe_hash")
  role           Role         @default(USER)
  createdAt      DateTime     @default(now()) @map("created_at")
  vaultEntries   VaultEntry[]

  @@map("users")
}

// ── Elite Trainer Box ────────────────────────────────────────────────────────
// Seul type de produit suivi par ETBVault. Le catalogue avait été élargi aux
// autres produits scellés puis ramené aux ETB ; il ne reste aucune trace de ce
// détour hors de l'historique git.
model Etb {
  id             String           @id
  nom            String                                  // nom exact Cardmarket (EN) — sert au lien CM
  nomFr          String?          @map("nom_fr")         // nom d'affichage FR (TCGdex)
  setId          String?          @map("set_id")         // set d'appartenance (TCGdex)
  era            String?
  imageUrl       String?          @map("image_url")      // logo de set TCGdex — unique source d'image
  dateSortie     DateTime?        @map("date_sortie") @db.Date
  prixSortie     Decimal?         @map("prix_sortie") @db.Decimal(10, 2)
  contenu        Json?
  cmUrl          String?          @map("cm_url")
  cmIdProducts   Int[]            @default([]) @map("cm_id_products")  // idProduct Cardmarket — sans eux, pas de prix
  cartes         Carte[]
  prixHistorique PrixHistorique[]
  vaultEntries   VaultEntry[]

  @@map("etbs")
}

model Carte {
  id         String   @id
  etbId      String   @map("etb_id")
  nom        String
  numero     String?
  imageUrl   String?  @map("image_url")
  rarete     String?
  prixMarche Decimal? @map("prix_marche") @db.Decimal(10, 2)
  misAJour   DateTime @default(now()) @map("mis_a_jour")
  etb        Etb      @relation(fields: [etbId], references: [id], onDelete: Cascade)

  @@index([etbId])
  @@map("cartes")
}

// ── Coffre utilisateur ───────────────────────────────────────────────────────
// Positions persistées en base, rattachées à un compte. Les visiteurs non
// connectés ont un coffre équivalent en localStorage, fusionné à la connexion.
model VaultEntry {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  etbId     String   @map("etb_id")
  prixAchat Decimal  @map("prix_achat") @db.Decimal(10, 2)
  quantite  Int      @default(1)
  dateAchat DateTime @map("date_achat") @db.Date
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  etb       Etb      @relation(fields: [etbId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([etbId])
  @@map("vault_entries")
}

// Un point de prix par ETB et par jour (contrainte unique). Alimenté par le
// Price Guide officiel Cardmarket ; `origine` distingue la collecte quotidienne
// d'un amorçage rétroactif.
model PrixHistorique {
  id            Int      @id @default(autoincrement())
  etbId         String   @map("etb_id")
  date          DateTime @db.Date
  cmPrixMoyen   Decimal? @map("cm_prix_moyen") @db.Decimal(10, 2)
  cmPrixBas     Decimal? @map("cm_prix_bas") @db.Decimal(10, 2)
  cmNbAnnonces  Int?     @map("cm_nb_annonces")
  ebayPrixMoyen Decimal? @map("ebay_prix_moyen") @db.Decimal(10, 2)
  origine       String   @default("collecte")
  etb           Etb      @relation(fields: [etbId], references: [id], onDelete: Cascade)

  @@unique([etbId, date])
  @@map("prix_historique")
}
