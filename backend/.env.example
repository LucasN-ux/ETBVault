# Base de données Postgres — REQUIS. Sans elle, le serveur démarre mais toutes
# les routes renvoient 500 (« Environment variable not found: DATABASE_URL »).
DATABASE_URL=postgresql://etbvault:etbvault@localhost:5432/etbvault?schema=public

# Auth — REQUIS pour /api/auth/*. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Email qui reçoit automatiquement le rôle ADMIN à l'inscription (optionnel)
ADMIN_EMAIL=

# Cardmarket — requis par le pipeline de prix (cron quotidien + /api/admin/refresh)
CM_EMAIL=
CM_PASSWORD=

PORT=3001
