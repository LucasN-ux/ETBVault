# Base de données Postgres — REQUIS. Sans elle, le serveur démarre mais toutes
# les routes renvoient 500 (« Environment variable not found: DATABASE_URL »).
# Local  : docker compose up -d, puis la valeur ci-dessous.
# Neon   : chaîne « pooled » du projet (hôte en -pooler), avec ?sslmode=require
DATABASE_URL=postgresql://etbvault:etbvault@localhost:5433/etbvault?schema=public

# Connexion DIRECTE — REQUIS aussi, Prisma refuse de démarrer sans elle.
# Sert uniquement aux migrations : le pooler Neon travaille en mode transaction
# et ne laisse pas passer les instructions DDL.
# Local  : identique à DATABASE_URL.
# Neon   : la même chaîne SANS « -pooler » dans le nom d'hôte.
DIRECT_URL=postgresql://etbvault:etbvault@localhost:5433/etbvault?schema=public

# Auth — REQUIS pour /api/auth/*. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Email qui reçoit automatiquement le rôle ADMIN à l'inscription (optionnel)
ADMIN_EMAIL=

# Cardmarket — requis par la collecte des prix. Sans eux le site fonctionne,
# mais aucun prix n'est collecté.
CM_EMAIL=
CM_PASSWORD=

# ── Déploiement ──────────────────────────────────────────────────────────────

# Origines autorisées à appeler l'API (CORS), séparées par des virgules.
# Vide = toutes, acceptable en local, jamais en production.
#   ORIGINES_AUTORISEES=https://etbvault.vercel.app
ORIGINES_AUTORISEES=

# Planifier les tâches quotidiennes dans le processus (défaut : true).
# À passer à false sur un hébergement qui met le service en veille : les
# tâches ne partiraient pas de façon fiable.
CRONS_ACTIFS=

# Lancer une collecte au démarrage du serveur (défaut : false).
# Ouvre un navigateur et se connecte à Cardmarket — à laisser désactivé sur un
# service qui redémarre souvent.
COLLECTE_AU_DEMARRAGE=

PORT=3001
