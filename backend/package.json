{
  "name": "etbvault-backend",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "seed": "node src/db/seed.js",
    "seed:prix": "node src/db/seedPrix.js",
    "refresh:etb": "tsx src/db/run-cm-refresh.ts",
    "boxes": "python3 src/db/remove-bg-boxes.py && node src/db/update-box-images.js",
    "test": "jest --testEnvironment node"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.7.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "node-cron": "^4.2.1",
    "playwright": "^1.60.0",
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/node-cron": "^3.0.11",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
